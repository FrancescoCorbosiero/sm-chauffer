# Copy to `.env` and fill in. The site runs fine with all of these blank —
# the booking/contact forms then fall back to the WhatsApp / mailto handoff.

# --- Public config (build-time) ----------------------------------------------
# NOTE: every NEXT_PUBLIC_* var below is inlined into the bundle when the image
# is BUILT (passed via docker-compose `build.args`). After changing any of them,
# rebuild: `docker compose up -d --build`. All are optional.

# Google Search Console verification token (the content of the
# <meta name="google-site-verification"> tag). Leave blank if unused.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. When set, GA4 loads with
# Consent Mode v2 *denied by default* and is only enabled after the visitor
# accepts the cookie banner (EU-compliant). Leave blank to disable GA entirely.
NEXT_PUBLIC_GA_ID=

# Umami — cookieless, GDPR-friendly analytics (no consent banner needed). Set
# both to enable. Self-host Umami on the same VPS behind Caddy, or use a hosted
# instance. SRC is the tracker script URL; WEBSITE_ID is the site's UUID.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Google Business Profile Place ID — switches on the future Google reviews
# surface (see src/lib/reviews.ts). Leave blank until you have real reviews.
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# --- Cloudflare Turnstile (anti-spam CAPTCHA, optional) ----------------------
# Free, privacy-friendly, invisible CAPTCHA on the contact form. Create a
# Turnstile widget at https://dash.cloudflare.com (no need to proxy the site
# through Cloudflare) to get both keys. With them unset, the form relies on the
# honeypot + timing trap + rate limiter instead.
#   - SITE_KEY is public (build arg, inlined into the client).
#   - SECRET_KEY is server-side (runtime env) and verifies the token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AWS SES email routing (the "WP Mail SMTP via SES" equivalent) -----------
# When all of AWS_REGION + SES_FROM_EMAIL + SES_TO_EMAIL are set, the /api/quote
# route sends booking/contact submissions through SES. Credentials are read
# from the standard AWS chain (the two AWS_* keys below, an instance role, etc.).
#
# Setup: verify SES_FROM_EMAIL (or its domain) as a sending identity in SES, and
# request production access to leave the SES sandbox (sandbox can only send to
# verified recipients). SES_TO_EMAIL can be any address (e.g. an external Gmail).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified SES sending identity (your domain mailbox).
SES_FROM_EMAIL=info@transferluxurydriverncc.it
# Where bookings are delivered. Accepts several recipients, comma-separated —
# they can mix the domain webmail and external inboxes (e.g. a Gmail).
SES_TO_EMAIL=info@transferluxurydriverncc.it,maksymnoleggio@gmail.com
